WRITE_API_KEY=salainen
SESSION_SECRET=fish-ai-dev-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aifishsortdb
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password

# Per client IP. API writes also count toward the overall API limit.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_WEB_MAX=300
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WRITE_MAX=60
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
# Direct Docker access: false. Behind a proxy: its exact IP or CIDR, comma separated.
TRUST_PROXY=false
