<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-water me-2"></i>Kalat</h2>
        <p class="text-muted mb-0">Lisää, selaa ja hallitse kalalajeja.</p>
    </div>
</div>

<div class="row mb-5">
    <div class="col-12">
        <div class="card p-4 shadow-sm border-0">
            <h4 class="mb-4 text-primary"><i class="bi bi-plus-circle-fill me-2"></i>Lisaa uusi kala</h4>

            <form id="addFishForm">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Kalan nimi *</label>
                        <input type="text" class="form-control bg-light" id="fishName" required placeholder="Esim. Hauki">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Tieteellinen nimi</label>
                        <input type="text" class="form-control bg-light" id="fishScientificName" placeholder="Esim. Esox lucius">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted">Sisainen tunniste</label>
                        <input type="text" class="form-control bg-light" value="Luodaan automaattisesti UUID:na" disabled>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fs-5 fw-bold">
                    <i class="bi bi-cloud-arrow-up me-2"></i> Tallenna kala tietokantaan
                </button>
            </form>

            <div id="fishMessage" class="mt-3"></div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <h4 class="mb-0">Kaikki kalat</h4>
        <button class="btn btn-sm btn-outline-secondary" type="button" id="refreshFishButton">
            <i class="bi bi-arrow-clockwise me-1"></i>Päivitä lista
        </button>
    </div>

    <div class="col-12">
        <div id="fishContainer" class="row g-4"></div>
    </div>
</div>

<div class="modal fade" id="editFishModal" tabindex="-1" aria-labelledby="editFishModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="editFishModalLabel">Muokkaa kalaa</h5>
                    <div class="text-muted small" id="editFishModalSubtitle"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sulje"></button>
            </div>

            <div class="modal-body">
                <form id="editFishForm">
                    <input type="hidden" id="editFishRecordId">

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Kalan nimi *</label>
                            <input type="text" class="form-control bg-light" id="editFishName" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Tieteellinen nimi</label>
                            <input type="text" class="form-control bg-light" id="editFishScientificName" placeholder="Esim. Esox lucius">
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer flex-column align-items-stretch gap-3">
                <div id="editFishMessage"></div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Peruuta</button>
                    <button type="submit" form="editFishForm" class="btn btn-primary fw-bold">
                        <i class="bi bi-save me-2"></i>Paivita kala
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
