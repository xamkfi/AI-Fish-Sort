<!DOCTYPE html>
<html lang="fi">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>

    {{#if adminLayout}}
      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
      <style>
        body { background-color: #f8f9fa; transition: background-color 0.2s, color 0.2s; }
        .sidebar { min-height: 100vh; background-color: #212529; color: white; padding-top: 20px; }
        .nav-pills .nav-link { color: #adb5bd; margin-bottom: 5px; }
        .nav-pills .nav-link.active { background-color: #0d6efd; color: white; }
        .card { box-shadow: 0 4px 6px rgba(0,0,0,0.05); border: none; border-radius: 8px; transition: background-color 0.2s, border-color 0.2s; }

        /* Dark mode */
        body.dark-mode {
          background-color: #0f1117 !important;
          color: #e2e8f0;
        }
        body.dark-mode .sidebar {
          background-color: #161b22 !important;
        }
        body.dark-mode .nav-pills .nav-link {
          color: #8b949e;
        }
        body.dark-mode .nav-pills .nav-link.active {
          background-color: #1f6feb;
        }
        body.dark-mode .card {
          background-color: #1a2332 !important;
          border: 1px solid #2d3748 !important;
          box-shadow: none;
        }
        body.dark-mode .card-title {
          color: #e2e8f0;
        }
        body.dark-mode .card-text {
          color: #a0aec0 !important;
        }
        body.dark-mode .text-muted {
          color: #a0aec0 !important;
        }
        body.dark-mode .text-primary {
          color: #63b3ed !important;
        }
        body.dark-mode .btn-primary {
          background-color: #2b6cb0;
          border-color: #2b6cb0;
        }
        body.dark-mode .btn-primary:hover {
          background-color: #3182ce;
        }
        body.dark-mode .btn-outline-secondary {
          color: #a0aec0;
          border-color: #4a5568;
        }
        body.dark-mode .btn-outline-secondary:hover {
          background-color: #2d3748;
          color: #e2e8f0;
        }
        body.dark-mode .form-control {
          background-color: #1a2332 !important;
          border-color: #2d3748 !important;
          color: #e2e8f0;
        }
        body.dark-mode .form-control::placeholder {
          color: #718096 !important;
        }
        body.dark-mode .form-control:focus {
          background-color: #1e293d !important;
          border-color: #4a5568;
          color: #e2e8f0;
        }
        body.dark-mode .form-control:focus::placeholder {
          color: #718096 !important;
        }
        body.dark-mode .form-label {
          color: #a0aec0;
        }
        body.dark-mode .form-text {
          color: #718096;
        }
        body.dark-mode .bg-light {
          background-color: #1a2332 !important;
          color: #e2e8f0 !important;
        }
        body.dark-mode .bg-light .text-muted {
          color: #94a3b8 !important;
        }
        body.dark-mode .border-dashed {
          border-color: #2d3748 !important;
        }
        body.dark-mode .bg-white {
          background-color: #1a2332 !important;
        }
        body.dark-mode .card-footer.bg-white {
          background-color: #1a2332 !important;
        }
        body.dark-mode .table {
          color: #e2e8f0;
        }
        body.dark-mode .modal-content {
          background-color: #1a2332;
          border-color: #2d3748;
        }
        body.dark-mode .modal-header {
          border-bottom-color: #2d3748;
        }
        body.dark-mode .modal-footer {
          border-top-color: #2d3748;
        }
        body.dark-mode .btn-close {
          filter: invert(0.8);
        }
        body.dark-mode .alert-success {
          background-color: #1a3a2a;
          border-color: #2d6a4f;
          color: #68d391;
        }
        body.dark-mode .alert-danger {
          background-color: #3a1a1a;
          border-color: #6a2d2d;
          color: #fc8181;
        }
        body.dark-mode hr {
          border-color: #2d3748 !important;
        }
        body.dark-mode .sidebar small {
          color: #8b949e !important;
        }

        .dark-toggle {
          display: flex;
          align-items: center;
          gap: 8px;
          padding: 6px 12px;
          margin: 4px 12px;
          border: 1px solid #495057;
          border-radius: 6px;
          background: transparent;
          color: #adb5bd;
          cursor: pointer;
          font-size: 0.83rem;
          transition: background 0.15s;
          width: calc(100% - 24px);
        }
        .dark-toggle:hover {
          background: rgba(255,255,255,0.08);
          color: #fff;
        }
        body.dark-mode .dark-toggle {
          border-color: #4a5568;
          color: #8b949e;
        }
        body.dark-mode .dark-toggle:hover {
          background: rgba(255,255,255,0.05);
          color: #e2e8f0;
        }
      </style>
    {{else}}
      <link rel="stylesheet" href="/stylesheets/style.css">
    {{/if}}
  </head>
  <body>
    {{#if adminLayout}}
      <div class="container-fluid">
        <div class="row">
          {{> sidebar}}

          <div class="col-md-9 col-lg-10 p-4">
            {{{body}}}
          </div>
        </div>
      </div>

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
      <script>
        (function() {
          var enabled = localStorage.getItem('darkMode') === 'true';
          var body = document.body;
          if (enabled) {
            body.classList.add('dark-mode');
          }

          var toggle = document.getElementById('darkModeToggle');
          var label = document.getElementById('darkModeLabel');
          var icon = toggle && toggle.querySelector('i');

          function updateLabel() {
            var isDark = body.classList.contains('dark-mode');
            if (label) label.textContent = isDark ? 'Vaalea tila' : 'Tumma tila';
            if (icon) {
              icon.className = isDark ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
            }
          }

          if (toggle) {
            updateLabel();
            toggle.addEventListener('click', function() {
              body.classList.toggle('dark-mode');
              var isDark = body.classList.contains('dark-mode');
              localStorage.setItem('darkMode', isDark);
              updateLabel();
            });
          }
        })();
      </script>
      {{#if script}}
        <script src="{{script}}"></script>
      {{/if}}
    {{else}}
      {{{body}}}
    {{/if}}
  </body>
</html>
