<button class="dm-toggle" id="dmToggle" title="Tumma tila"
  style="position:fixed;bottom:20px;right:20px;z-index:999;width:44px;height:44px;border-radius:50%;border:1px solid #c1d1d8;background:#fff;color:#172026;cursor:pointer;font-size:1.2rem;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,0.12);transition:background 0.2s,color 0.2s,border-color 0.2s;">
  <span id="dmIcon">☾</span>
</button>
<script>
(function(){
  var e=localStorage.getItem('darkMode')==='true';
  if(e)document.body.classList.add('dark-mode');
  var b=document.getElementById('dmToggle'),i=document.getElementById('dmIcon');
  if(b){i.textContent=e?'☀':'☾';
  b.addEventListener('click',function(){
    document.body.classList.toggle('dark-mode');
    var d=document.body.classList.contains('dark-mode');
    localStorage.setItem('darkMode',d);
    i.textContent=d?'☀':'☾';
  });}
})();
</script>
<script src="/javascripts/apiGuide.js"></script>
