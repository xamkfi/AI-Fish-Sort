<!DOCTYPE html>
<html lang="fi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #212529;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            width: 100%;
            max-width: 400px;
            background-color: #2c3034;
            border: 1px solid #495057;
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }
        .login-card .card-body {
            padding: 2.5rem;
        }
        .form-control {
            background-color: #343a40;
            border-color: #495057;
            color: #f8f9fa;
        }
        .form-control:focus {
            background-color: #3d4349;
            border-color: #0d6efd;
            color: #f8f9fa;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }
        .form-control::placeholder {
            color: #6c757d;
        }
        .form-label {
            color: #adb5bd;
            font-size: 0.875rem;
            font-weight: 500;
        }
        .btn-login {
            background-color: #0d6efd;
            border-color: #0d6efd;
            padding: 0.6rem;
            font-weight: 600;
        }
        .btn-login:hover {
            background-color: #0b5ed7;
            border-color: #0a58ca;
        }

        body.light-mode {
            background-color: #f4f6f9 !important;
        }
        body.light-mode .login-card {
            background-color: #ffffff;
            border-color: #e2e8f0;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
        }
        body.light-mode .login-card .text-white {
            color: #1a202c !important;
        }
        .login-card .text-muted {
            color: #9ca3af !important;
        }
        body.light-mode .login-card .text-muted {
            color: #718096 !important;
        }
        body.light-mode .form-control {
            background-color: #ffffff;
            border-color: #e2e8f0;
            color: #1a202c;
        }
        body.light-mode .form-control:focus {
            background-color: #ffffff;
            border-color: #3182ce;
            color: #1a202c;
        }
        body.light-mode .form-control::placeholder {
            color: #a0aec0;
        }
        body.light-mode .form-label {
            color: #4a5568;
        }

        .dm-toggle {
            position: fixed; bottom: 20px; right: 20px; z-index: 999;
            width: 44px; height: 44px; border-radius: 50%;
            border: 1px solid #495057; background: #2c3034;
            color: #f8f9fa; cursor: pointer; font-size: 1.2rem;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
            transition: background 0.2s, color 0.2s, border-color 0.2s;
        }
        .dm-toggle:hover {
            background: #3d4349;
        }
        body.light-mode .dm-toggle {
            background: #ffffff;
            border-color: #e2e8f0;
            color: #1a202c;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }
        body.light-mode .dm-toggle:hover {
            background: #f7fafc;
        }
    </style>
</head>
<body>

<div class="login-card card">
    <div class="card-body">
        <div class="text-center mb-4">
            <i class="bi bi-shield-lock-fill text-primary" style="font-size: 2.5rem;"></i>
            <h4 class="text-white mt-2 mb-0">Fish AI Admin</h4>
            <small class="text-muted">Kirjaudu hallintapaneeliin</small>
        </div>

        {{#if error}}
        <div class="alert alert-danger py-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> {{error}}
        </div>
        {{/if}}

        <form method="POST" action="/login">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">

            <div class="mb-3">
                <label for="username" class="form-label">Kayttajanimi</label>
                <input type="text" class="form-control" id="username" name="username"
                       placeholder="Syötä käyttäjänimi" required autofocus autocomplete="username">
            </div>

            <div class="mb-4">
                <label for="password" class="form-label">Salasana</label>
                <input type="password" class="form-control" id="password" name="password"
                       placeholder="Syötä salasana" required autocomplete="current-password">
            </div>

            <button type="submit" class="btn btn-login btn-primary w-100">
                <i class="bi bi-box-arrow-in-right me-1"></i> Kirjaudu
            </button>

            <a href="/" class="btn w-100 mt-3" style="background-color:#dc3545;border-color:#dc3545;color:#fff;font-weight:600;padding:0.6rem;">
                <i class="bi bi-house-door me-1"></i> Takaisin etusivulle
            </a>
        </form>
    </div>
</div>

<button class="dm-toggle" id="dmToggle" title="Vaihda teemaa">
    <span id="dmIcon">☀</span>
</button>
<script>
(function() {
    var isLight = localStorage.getItem('darkMode') === 'false';
    if (isLight) document.body.classList.add('light-mode');
    var btn = document.getElementById('dmToggle');
    var icon = document.getElementById('dmIcon');
    if (btn) {
        icon.textContent = isLight ? '☾' : '☀';
        btn.addEventListener('click', function() {
            document.body.classList.toggle('light-mode');
            var light = document.body.classList.contains('light-mode');
            localStorage.setItem('darkMode', light ? 'false' : 'true');
            icon.textContent = light ? '☾' : '☀';
        });
    }
})();
</script>

</body>
</html>
